@model IReadOnlyList<Inventory.Contract.ProductDto>
@{
    ViewData["Title"] = "Products";
}

<div class="page-header d-flex flex-column flex-sm-row justify-content-between align-items-start gap-3">
    <div>
        <h1 class="page-title">Products</h1>
        <p class="page-subtitle">Catalog items and pricing.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add product</a>
</div>

<div class="surface-card">
    <div class="card-inner flush">
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th class="text-end">Price</th>
                        <th class="text-end" style="min-width: 9rem">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td class="text-end">@item.Price.ToString("N2")</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this product?');">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
