@model Inventory.Web.ViewModels.PurchaseVm
@{
    ViewData["Title"] = "Purchase";
}

<div class="page-header">
    <h1 class="page-title">Purchase (warehouse)</h1>
    <p class="page-subtitle">Add incoming stock to the warehouse.</p>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success mb-4" role="status">@successMessage</div>
}

<div class="surface-card form-panel">
    <div class="card-inner">
        <form method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="ProductId" class="form-label"></label>
                <select asp-for="ProductId" asp-items="Model.Products" class="form-select"></select>
                <span asp-validation-for="ProductId" class="text-danger small"></span>
            </div>

            <div class="mb-0">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" inputmode="numeric" />
                <span asp-validation-for="Quantity" class="text-danger small"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Record purchase</button>
            </div>
        </form>
    </div>
</div>
