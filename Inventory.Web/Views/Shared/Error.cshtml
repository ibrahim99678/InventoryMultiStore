@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-header">
    <h1 class="page-title text-danger">Something went wrong</h1>
    <p class="page-subtitle">The request could not be completed.</p>
</div>

<div class="surface-card border-danger" style="border-width: 2px;">
    <div class="card-inner">
        <p class="mb-3">An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p class="mb-0 small text-muted">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <hr class="my-4" />

        <h2 class="h6 fw-bold">Development mode</h2>
        <p class="small text-muted mb-0">
            Swapping to the Development environment shows more detailed errors. For production, set <code>ASPNETCORE_ENVIRONMENT</code> appropriately.
        </p>
    </div>
</div>
