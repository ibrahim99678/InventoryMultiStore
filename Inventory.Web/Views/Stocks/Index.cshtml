@model Inventory.Web.ViewModels.StockIndexVm
@{
    ViewData["Title"] = "Stock";
}

<div class="page-header">
    <h1 class="page-title">Stock by location</h1>
    <p class="page-subtitle">Choose a store to see on-hand quantities.</p>
</div>

<div class="surface-card mb-4">
    <div class="card-inner">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-8 col-lg-6">
                <label class="form-label">Store</label>
                <select class="form-select" name="storeId" asp-items="Model.Stores"></select>
            </div>
            <div class="col-md-4 col-lg-auto">
                <button type="submit" class="btn btn-primary">View stock</button>
            </div>
        </form>
    </div>
</div>

<div class="surface-card">
    <div class="card-inner flush">
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Stocks)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td class="text-end"><span class="fw-semibold tabular-nums">@item.Quantity</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
