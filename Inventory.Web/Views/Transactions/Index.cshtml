@model Inventory.Web.ViewModels.TransactionIndexVm
@{
    ViewData["Title"] = "Transactions";
}

<div class="page-header">
    <h1 class="page-title">Transaction history</h1>
    <p class="page-subtitle">Filter by store or product; all times are UTC.</p>
</div>

<div class="surface-card mb-4">
    <div class="card-inner">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Store</label>
                <select class="form-select" name="storeId" asp-items="Model.Stores"></select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Product</label>
                <select class="form-select" name="productId" asp-items="Model.Products"></select>
            </div>
            <div class="col-md-4">
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">Apply filters</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="surface-card">
    <div class="card-inner flush">
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Date (UTC)</th>
                        <th>Type</th>
                        <th>Product</th>
                        <th>From</th>
                        <th>To</th>
                        <th class="text-end">Qty</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Transactions)
                    {
                        var typeClass = item.TransactionType switch
                        {
                            Inventory.Contract.TransactionTypeDto.Purchase => "badge-purchase",
                            Inventory.Contract.TransactionTypeDto.Sale => "badge-sale",
                            Inventory.Contract.TransactionTypeDto.Transfer => "badge-transfer",
                            _ => ""
                        };
                        <tr>
                            <td class="text-muted small text-nowrap">@item.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="badge-type @typeClass">@item.TransactionType</span>
                            </td>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td class="text-muted">@(item.FromStoreName ?? "—")</td>
                            <td class="text-muted">@(item.ToStoreName ?? "—")</td>
                            <td class="text-end tabular-nums">@item.Quantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
