@model Inventory.Web.ViewModels.TransactionIndexVm

@{
    ViewData["Title"] = "Transactions";
}

<h1 class="h3">Transactions</h1>

<form method="get" class="row g-3 mt-1 mb-3">
    <div class="col-md-4">
        <label class="form-label">Store</label>
        <select class="form-select" name="storeId" asp-items="Model.Stores">
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Product</label>
        <select class="form-select" name="productId" asp-items="Model.Products">
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a class="btn btn-secondary ms-2" asp-action="Index">Reset</a>
    </div>
</form>

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>Date (UTC)</th>
            <th>Type</th>
            <th>Product</th>
            <th>From</th>
            <th>To</th>
            <th class="text-end">Qty</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Transactions)
        {
            <tr>
                <td>@item.TransactionDate.ToString("u")</td>
                <td>@item.TransactionType</td>
                <td>@item.ProductName</td>
                <td>@item.FromStoreName</td>
                <td>@item.ToStoreName</td>
                <td class="text-end">@item.Quantity</td>
            </tr>
        }
    </tbody>
</table>
